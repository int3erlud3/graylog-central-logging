# Copy to .env and fill in, or generate everything with: scripts/init-env.sh
# docker compose refuses to start while any of these values is empty.
# Never commit .env.

# Pepper for Graylog password hashing and encryption (at least 64 random characters)
GRAYLOG_PASSWORD_SECRET=
# SHA-256 hex digest of the Graylog "admin" password: printf '%s' 'password' | sha256sum
GRAYLOG_ROOT_PASSWORD_SHA2=
# MongoDB root account (only used to create the Graylog database user on first start)
MONGODB_ROOT_PASSWORD=
# MongoDB account used by Graylog (letters and digits only, it is embedded in a URI)
MONGODB_GRAYLOG_PASSWORD=

# Optional settings (empty = default)
# Public URL of the web interface, e.g. https://graylog.example.com/ (default http://127.0.0.1:9000/)
GRAYLOG_HTTP_EXTERNAL_URI=
# Host address for the TLS inputs 6514/tcp and 12201/tcp (default 127.0.0.1; use the server's LAN IP to accept clients)
INPUT_BIND_ADDRESS=
# OpenSearch JVM heap (default 1g)
OPENSEARCH_HEAP=
